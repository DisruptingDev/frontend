  impuestos_locales    impuestos_locales? @relation(fields: [impuestos_locales_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_impuestos_locales_traslados_locales")
}

model ubicaciones {
  id                            BigInt        @id @default(autoincrement())
  tipo_ubicacion                String        @db.VarChar(10)
  id_ubicacion                  String?       @db.VarChar(30)
  rfc_remitente_destinatario    String        @db.VarChar(13)
  nombre_remitente_destinatario String?       @db.VarChar(254)
  num_reg_id_trib               String?       @db.VarChar(40)
  residencia_fiscal             String?       @db.VarChar(3)
  fecha_hora_salida_llegada     DateTime      @db.Timestamptz(6)
  distancia_recorrida           Decimal?      @db.Decimal(16, 3)
  carta_porte_id                BigInt?
  domicilios                    domicilios[]
  carta_portes                  carta_portes? @relation(fields: [carta_porte_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_carta_portes_ubicaciones")
}
